# =====================================================================
# Schema Dgraph - Plataforma VibeCoders (corregido)
#
# Cambios aplicados a partir de la revision intermedia:
#   - Se usan los UIDs autogenerados por Dgraph para todas las relaciones.
#     Los id_* del CSV se conservan SOLO como identificador logico
#     (para lookups con @index) y para vincular con Mongo / Cassandra,
#     no se usan como UID interno.
#   - "preguntas" pasa a ser arreglo de strings ([string]).
#   - Se eliminan facetas redundantes en inscrito_en
#     (sessions_count y activity_status ya viven en Cassandra,
#     last_access se mantiene una sola vez).
#   - Se eliminan duplicados de calificacion: el "score" vive solo
#     como faceta en entrega_tarea / realiza_examen.
#   - Se agregan las relaciones que la doc ya describia pero
#     faltaban en el schema: asigna_tarea, califica_tarea,
#     califica_examen (RF02 / docencia).
# =====================================================================

# ---------------------- TIPOS DE NODO --------------------------------
type Alumno {
  id_alumno
  nombre
  genero
  inscrito_en
  realiza_examen
  entrega_tarea
  obtiene_certificado
}

type Curso {
  id_curso
  nombre
  categoria
  day_of_week
  start_time
  end_time
  contiene_tarea
  tiene_examenes
  es_prerrequisito_de
}

type Maestro {
  id_maestro
  nombre
  genero
  imparte
  asigna_tarea
  califica_tarea
  califica_examen
}

type Tarea {
  id_tarea
}

type Examen {
  id_examen
  preguntas
}

type Certificado {
  id_certificado
  fecha
  categoria
}

# ---------------------- PREDICADOS (atributos) -----------------------
# id_* son strings logicos provenientes del CSV; sirven para
# emparejar con Mongo / Cassandra y para lookup rapido por @index.
id_alumno:      string @index(exact) .
id_curso:       string @index(exact) .
id_maestro:     string @index(exact) .
id_tarea:       string @index(exact) .
id_examen:      string @index(exact) .
id_certificado: string @index(exact) .

nombre:      string @index(exact, term) .
genero:      string .
categoria:   string @index(exact) .

# RF07 - horario directo en el nodo Curso
day_of_week: string @index(exact) .
start_time:  string .
end_time:    string .

# preguntas como arreglo de strings (correccion del profe)
preguntas:   [string] .

fecha:       datetime .

# ---------------------- RELACIONES -----------------------------------
# RF01 / RF08 / RF10 - inscripcion + actividad + progreso
# Facetas: enrolled_at, status, progress, last_access
inscrito_en:        [uid] @reverse .

# RF02 - asignacion de maestro a curso. Faceta: assigned_at
imparte:            [uid] @reverse .

# RF03 - entrega de tareas. Facetas: submitted_at, status, score
entrega_tarea:      [uid] @reverse .

# RF04 - examenes presentados. Facetas: attempt_date, score
realiza_examen:     [uid] @reverse .

# RF05 - tareas por curso. Faceta: due_date
contiene_tarea:     [uid] @reverse .

# Examenes por curso (sin facetas)
tiene_examenes:     [uid] @reverse .

# RF09 - prerrequisitos
es_prerrequisito_de: [uid] @reverse .

# Certificados obtenidos
obtiene_certificado: [uid] @reverse .

# Relaciones docentes que faltaban en el schema
asigna_tarea:       [uid] @reverse .   # Maestro -> Tarea
califica_tarea:     [uid] @reverse .   # Maestro -> Tarea (faceta: score)
califica_examen:    [uid] @reverse .   # Maestro -> Examen (faceta: score)
